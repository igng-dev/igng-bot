# Copy to .env on the deployment host and fill in real values.
# Never commit .env or real credentials.
#
# NOTE: production runs from deploy/docker/.env (the compose stack). This file
# documents the variables the bot itself reads; keep the two in sync.
#
# OneBot endpoints. Inside the NAS compose network the QQ client is a sibling
# service named "napcat", so these default to the compose service names.
ONEBOT_WS_URL=ws://napcat:3001
ONEBOT_ACCESS_TOKEN=
ONEBOT_HTTP_URL=http://napcat:3000
ONEBOT_HTTP_TOKEN=
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
MC_DB_HOST=
MC_DB_PORT=3306
MC_DB_USER=
MC_DB_PASSWORD=
MC_DB_NAME=mc
# Attachment storage root. Inside the container this is a bind mount onto the
# NAS data directory; the CIFS/SMB client is no longer used.
MESSAGE_ROOT=/data/message_logs
# Refuse to start when the attachment root is missing instead of silently
# falling back to container-local storage (which hides every attachment).
STORAGE_REQUIRE_MOUNT=1
# Historical prefixes re-anchored onto MESSAGE_ROOT when reading old rows.
LEGACY_PATH_PREFIXES=/mnt/media/message_logs,/vol1/1000/IGNGbot/message_logs,/data/message_logs
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
LLM_CLOUD_BASE_URL=https://api.openai.com/v1
LLM_CLOUD_API_KEY=
LLM_CLOUD_MODEL=
# 本地/默认聊天 LLM 配置（可对接中转站或本地兼容端点）
LLM_LOCAL_BASE_URL=https://api.example.org/v1
LLM_LOCAL_API_KEY=
LLM_LOCAL_MODEL=gemini-flash
LLM_LOCAL_MULTIMODAL=1

# Incoming image OCR.  rapidocr runs locally; use vision_llm only with a
# multimodal OpenAI-compatible endpoint and set MEDIA_OCR_BASE_URL/MODEL.
MEDIA_OCR_ENABLED=1
MEDIA_OCR_PROVIDER=rapidocr
MEDIA_OCR_BASE_URL=
MEDIA_OCR_API_KEY=
MEDIA_OCR_MODEL=InternVL2.5-4B-MPO
MEDIA_OCR_TIMEOUT=90
MEDIA_OCR_MAX_CHARS=4000

# Incoming voice transcription.  faster-whisper downloads/uses the model
# lazily on first voice message unless MEDIA_ASR_MODEL_DIR already contains it.
MEDIA_ASR_ENABLED=1
MEDIA_ASR_PROVIDER=faster-whisper
MEDIA_ASR_MODEL=small
MEDIA_ASR_MODEL_DIR=
MEDIA_ASR_DEVICE=cpu
MEDIA_ASR_COMPUTE_TYPE=int8
MEDIA_ASR_LANGUAGE=zh
MEDIA_ASR_BEAM_SIZE=5
MEDIA_ASR_VAD_FILTER=1
MEDIA_ASR_CONVERT_AUDIO=1
MEDIA_ASR_FFMPEG_BIN=ffmpeg
MEDIA_ASR_TEMP_DIR=
MEDIA_ASR_BASE_URL=
MEDIA_ASR_API_KEY=

ANIME_API_BASE_URL=http://192.0.2.34:23335
CONTEXT_MAX_TOKENS=8192
CHAT_DEBOUNCE_SECONDS=1.5
CHAT_NON_DIRECT_COOLDOWN_SECONDS=15
CHAT_HISTORY_MAX_MESSAGES=12
CHAT_HISTORY_MAX_TOKENS=1600
CHAT_DIRECT_ALIASES=云萤,莹宝
CHAT_INCLUDE_SUMMARY=0
# system_prompts.chat is authoritative; this is only the local runtime cache.
SYSTEM_PROMPT_CACHE_DIR=runtime/system_prompts
SYSTEM_PROMPT_SYNC_INTERVAL_SECONDS=60
CCODE_BASE_URL=https://api.ccode.vip/v1
CCODE_API_KEY=
CCODE_IMAGE_TIMEOUT=900
IMAGE_STANDARD_MODELS=
# 旧图片生成功能的输出目录（功能已移除，仅保留兼容）。
IMAGE_STORAGE_PATH=/data/igngbot/images
IGNG_SITE_DB_HOST=
IGNG_SITE_DB_PORT=3306
IGNG_SITE_DB_USER=
IGNG_SITE_DB_PASSWORD=
IGNG_SITE_DB_NAME=igng_sites
MC_TICKET_NOTIFICATION_GROUP=1000000007
MC_TICKET_TECH_NOTIFICATION_GROUP=1000000006
MC_TICKET_POLL_INTERVAL=10
MC_TICKET_ADMIN_URL=https://mc.igng.net/admin
MC_TICKET_TIMEZONE=Asia/Shanghai
MC_TICKET_DAILY_REMINDER_HOUR=10
NTFY_REPORT_TOKEN=
