#!/usr/bin/env sh
# 设备级 pre-push 守卫（solo：只拦非快进与删除集成分支）+ 全工作区隐私扫描
set -u
PROTECTED="main master"
ZEROS=0000000000000000000000000000000000000000
blocked=0
while read -r ref local remote; do
  [ -n "$ref" ] || continue
  name=${ref#refs/heads/}
  case " $PROTECTED " in *" $name "*)
    if [ "$local" = "$ZEROS" ]; then echo "pre-push 拒绝：不允许删除远端 $name" >&2; blocked=1
    elif [ "$remote" != "$ZEROS" ] && ! git merge-base --is-ancestor "$remote" "$local" 2>/dev/null; then echo "pre-push 拒绝：$name 非快进，需要 --force" >&2; blocked=1; fi ;;
  esac
done
[ $blocked -eq 0 ] || exit 1
exec sh scripts/privacy-scan.sh
