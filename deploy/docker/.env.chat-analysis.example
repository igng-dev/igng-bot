# Distinct secrets; generate locally. Never reuse the social, historian or infrastructure secrets.
CHAT_ANALYSIS_ADMIN_SECRET=
CHAT_ANALYSIS_DSH_SECRET=
CHAT_ANALYSIS_DEFAULT_TIMEZONE=Asia/Shanghai
# 1 = create one run per enabled group per completed day; 0 keeps manual runs only.
CHAT_ANALYSIS_SCHEDULE=1
CHAT_ANALYSIS_BUFFER_SECONDS=1800
CHAT_ANALYSIS_CATCH_UP_DAYS=3
CHAT_ANALYSIS_PROVIDER=deepseek-official
CHAT_ANALYSIS_MODEL=deepseek-v4-flash
CHAT_ANALYSIS_MAX_STEPS=300
CHAT_ANALYSIS_TOKEN_BUDGET=3000000
CHAT_ANALYSIS_MAX_SECONDS=2700
CHAT_ANALYSIS_OUTPUT_TOKENS=8192
CHAT_ANALYSIS_MAX_MESSAGES=60000
# Configure the official DSH model provider in this independent profile's operator patch
# and declare its real contextWindow; do not inherit a guessed QQ model capacity.
