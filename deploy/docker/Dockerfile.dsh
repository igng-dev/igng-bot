# Upstream DSH is installed as published; YunYing is a normal local bundle.
ARG NODE_IMAGE=dockerproxy.net/library/node:24-bookworm-slim
FROM ${NODE_IMAGE}
ENV NODE_ENV=production DSH_HOME=/data/dsh DSH_TELEMETRY_DISABLED=1 TZ=Asia/Shanghai
WORKDIR /app/yunying-dsh
COPY yunying-dsh/package.json yunying-dsh/package-lock.json ./
# The published CLI is deliberately retained to install/start official Profiles.
RUN npm ci --include=dev --ignore-scripts && npm install --global pnpm@10.33.0 --ignore-scripts
COPY yunying-dsh/ ./
COPY scripts/run-yunying-profile.sh /app/run-yunying-profile.sh
RUN mkdir -p /data/dsh && chown -R 1000:1001 /app /data
USER 1000:1001
ENTRYPOINT ["sh", "/app/run-yunying-profile.sh"]
