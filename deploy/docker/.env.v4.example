# Keep the existing .env for DB/OneBot/media/OCR/ASR. Copy this file to .env.v4.
# Generate each secret independently with: python -c 'import secrets; print(secrets.token_hex(32))'
YUNYING_INTERNAL_SECRET=
# Optional separate owner/website API credential; never put this into a model prompt.
YUNYING_ADMIN_SECRET=
YUNYING_ALLOW_GROUPS=
YUNYING_ALLOW_PRIVATE=
YUNYING_NICKNAMES=云萤,莹宝
YUNYING_MODEL_PROVIDER=deepseek-official
YUNYING_MODEL=deepseek-v4-flash
YUNYING_MAX_TOKENS=4096
# bing preserves donor search. Choose deepseek to use upstream authenticated search in proxy/Fake-IP deployments.
YUNYING_SEARCH_PROVIDER=bing
DEEPSEEK_API_KEY=
# Current upstream uses its Messages-compatible endpoint, not V3 chat/completions.
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
# Auxiliary search has its own official endpoint (including /v1).
DEEPSEEK_SEARCH_BASE_URL=https://api.deepseek.com/anthropic/v1
# Set immutable tags matching the built source revision before cutover.
BOT_V4_IMAGE=
YUNYING_IMAGE=
