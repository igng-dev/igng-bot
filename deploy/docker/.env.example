# IGNGbot NAS deployment configuration.
# Copy to .env next to docker-compose.yml and fill in real values.
# Never commit the real .env.

# ---------------------------------------------------------------------------
# Paths on the NAS
# ---------------------------------------------------------------------------
# Attachment tree, reused in place from the previous CIFS-mounted location.
BOT_STORAGE_ROOT=/vol2/1000/Docker/igngbot/data/message_logs

# ---------------------------------------------------------------------------
# Images
# ---------------------------------------------------------------------------
BOT_IMAGE=igngbot-v3:local
NAPCAT_IMAGE=snowluma-docker-framework:local
BOT_MEDIA_IMAGE=igng-bot-media:local
BOT_MEDIA_FRPC_IMAGE=igng-bot-media-nas-frpc

# ---------------------------------------------------------------------------
# NapCat host ports (bound to loopback only; the bot uses the compose network).
# Host 3000/3001 are occupied by an unrelated container, so different host
# ports are used while the container-internal ports stay 3000/3001.
# ---------------------------------------------------------------------------
ONEBOT_HTTP_HOST_PORT=3200
ONEBOT_WS_HOST_PORT=3201
SNOWLUMA_WEBUI_HOST_PORT=5099
NOVNC_PORT=6081
VNC_PASSWD=
SNOWLUMA_UID=1000
SNOWLUMA_GID=1000

# ---------------------------------------------------------------------------
# OneBot (container-internal service names; normally left as-is)
# ---------------------------------------------------------------------------
ONEBOT_WS_URL=ws://napcat:3001
ONEBOT_ACCESS_TOKEN=
ONEBOT_HTTP_URL=http://napcat:3000
ONEBOT_HTTP_TOKEN=
ONEBOT_NAME=SnowLuma OneBot
BOT_USER_ID=

# ---------------------------------------------------------------------------
# Databases (cloud RDS; unchanged by the container migration)
# ---------------------------------------------------------------------------
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=igng_bot
# RDS enforces require_secure_transport, so every MySQL client (bot, work-notify
# pools, DSH Profile) must use TLS. Set DB_SSL=1 in production. Verification is
# off by default because the RDS CA is not in the container trust store; set
# DB_SSL_CA=/path/to/rds-ca.pem to verify the server certificate instead.
DB_SSL=1
DB_SSL_VERIFY=0
DB_SSL_CA=

MC_DB_HOST=
MC_DB_PORT=3306
MC_DB_USER=
MC_DB_PASSWORD=
MC_DB_NAME=mc

# Site AI records mirror (ai_jobs / ai_job_attempts). These tables live in the
# Beijing RDS igng_sites schema; the mirror is a no-op if left unset.
SITE_AI_RECORDS_ENABLED=1
SITE_AI_DB_HOST=
SITE_AI_DB_PORT=3306
SITE_AI_DB_USER=
SITE_AI_DB_PASSWORD=
SITE_AI_DB_NAME=igng_sites

# Central IGNG site database (tickets / identity).
IGNG_SITE_DB_HOST=
IGNG_SITE_DB_PORT=3306
IGNG_SITE_DB_USER=
IGNG_SITE_DB_PASSWORD=
IGNG_SITE_DB_NAME=igng_sites

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
MESSAGE_ROOT=/data/message_logs
STORAGE_REQUIRE_MOUNT=1
LEGACY_PATH_PREFIXES=/mnt/media/message_logs,/vol1/1000/IGNGbot/message_logs,/data/message_logs

# ---------------------------------------------------------------------------
# LLM endpoints
# ---------------------------------------------------------------------------
LLM_LOCAL_BASE_URL=
LLM_LOCAL_API_KEY=
LLM_LOCAL_MODEL=
LLM_LOCAL_MULTIMODAL=1
LLM_CLOUD_BASE_URL=
LLM_CLOUD_API_KEY=
LLM_CLOUD_MODEL=

# ---------------------------------------------------------------------------
# Media text extraction (runs inside the container)
# ---------------------------------------------------------------------------
MEDIA_OCR_ENABLED=1
MEDIA_OCR_PROVIDER=rapidocr
MEDIA_OCR_MAX_CHARS=4000

MEDIA_ASR_ENABLED=1
MEDIA_ASR_PROVIDER=faster-whisper
MEDIA_ASR_MODEL=small
MEDIA_ASR_MODEL_DIR=/data/models
MEDIA_ASR_DEVICE=cpu
MEDIA_ASR_COMPUTE_TYPE=int8
MEDIA_ASR_LANGUAGE=zh
MEDIA_ASR_CONVERT_AUDIO=1
MEDIA_ASR_FFMPEG_BIN=ffmpeg

# ---------------------------------------------------------------------------
# Chat behaviour
# ---------------------------------------------------------------------------
CONTEXT_MAX_TOKENS=8192
CHAT_DEBOUNCE_SECONDS=1.5
CHAT_NON_DIRECT_COOLDOWN_SECONDS=15
CHAT_HISTORY_MAX_MESSAGES=12
CHAT_HISTORY_MAX_TOKENS=1600
CHAT_DIRECT_ALIASES=云萤,莹宝
CHAT_INCLUDE_SUMMARY=0
SYSTEM_PROMPT_SYNC_INTERVAL_SECONDS=60

# ---------------------------------------------------------------------------
# MC tickets / notifications
# ---------------------------------------------------------------------------
MC_TICKET_NOTIFICATION_GROUP=
MC_TICKET_TECH_NOTIFICATION_GROUP=
MC_TICKET_POLL_INTERVAL=10
MC_TICKET_ADMIN_URL=https://mc.igng.net/admin
MC_TICKET_TIMEZONE=Asia/Shanghai
MC_TICKET_DAILY_REMINDER_HOUR=10
NTFY_REPORT_URL=https://ntfy.example.com/reports
NTFY_REPORT_TOKEN=

# ---------------------------------------------------------------------------
# Media delivery service (igng-bot-media)
# Shared with the IGNG site through MEDIA_PUBLIC_SECRET.
# ---------------------------------------------------------------------------
BOT_MEDIA_SECRET=
BOT_MEDIA_PUBLIC_GROUPS=<group-id-1>,<group-id-2>
MEDIA_UID=1000
MEDIA_GID=1001
