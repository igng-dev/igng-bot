# Configure secrets through the operator's ignored .env.slang, never this example.
SLANG_ADMIN_SECRET=
SLANG_DSH_SECRET=
SLANG_READ_SECRET=
SLANG_CURATOR_ENABLED=0
SLANG_PROVIDER=deepseek-official
SLANG_MODEL=deepseek-v4-flash
SLANG_MAX_STEPS=24
SLANG_TOKEN_BUDGET=30000
SLANG_MAX_SECONDS=600
SLANG_DAILY_JOBS=10
SLANG_DAILY_TOKENS=150000
SLANG_ASR_URL=
SLANG_ASR_MODEL=whisper-1
SLANG_VISION_URL=
SLANG_VISION_MODEL=
SLANG_MEDIA_API_KEY=
SLANG_EMBEDDING_URL=
SLANG_EMBEDDING_MODEL=
SLANG_EMBEDDING_DAILY_INPUTS=200
SLANG_AUXILIARY_DAILY_INPUTS=200
# Social Profile settings: reader credential alone does not grant per-scope consent.
YUNYING_SLANG_ENABLED=1
YUNYING_SLANG_RECOMMEND=1
YUNYING_SLANG_SEMANTIC=0
YUNYING_SLANG_BUDGET=900
YUNYING_SLANG_TIMEOUT_MS=150
YUNYING_SLANG_SEMANTIC_TIMEOUT_MS=800
